@page "/simulation"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using RoBotClient.Bot.Behavior
@using RoBotClient.Bot.Manager
@using RoBotClient.Bot.Offline
@using RoBotClient.Web.Components
@inherits LiveComponent
@implements IAsyncDisposable
@inject BotManager Bots
@inject SimRunner Runner
@inject BotConfigStore Configs
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject SimSprites Sprites
@inject RouteChecks Routes

<PageTitle>Simulation - RagBot Control</PageTitle>

<style>
    .sim-tile { background: var(--bs-tertiary-bg); border-radius: .5rem; padding: .5rem .75rem; min-width: 8.5rem; }
    .sim-tile .v { font-size: 1.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .sim-tile .l { font-size: .75rem; color: var(--bs-secondary-color); }
    .sim-pre { background: #1e1e1e; color: #d4d4d4; padding: .75rem; border-radius: .5rem; font-size: .75rem; white-space: pre; overflow: auto; max-height: 60vh; }
    .cap-server { border-left: 3px solid #198754; } .cap-shared { border-left: 3px solid #3b9dff; }
    .cap-approximated { border-left: 3px solid #ffc107; } .cap-absent { border-left: 3px solid #6c757d; }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h3 mb-0">Simulation</h1>
        <span class="badge bg-secondary rounded-pill fs-6">@_runs.Count saved leveling runs</span>
    </div>
    <span class="small text-secondary">Leveling and survival simulations run offline. No live bot is started or touched.</span>
</div>

<SimQueue />

<div class="card mb-3">
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button type="button" class="nav-link @(_activeTab == "leveling" ? "active" : "")" @onclick='() => _activeTab = "leveling"'>Leveling simulation</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_activeTab == "survival" ? "active" : "")" @onclick='() => _activeTab = "survival"'>Survival simulation</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_activeTab == "schedule" ? "active" : "")" @onclick='() => _activeTab = "schedule"'>Scan schedule</button></li>
        </ul>
        @if (_activeTab == "leveling")
        {
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Character build</label>
                <select class="form-select form-select-sm" value="@_bot" @onchange="e => PickBot((string)e.Value!)">
                    @foreach (var b in _bots) { <option value="@b">@b</option> }
                </select>
                <div class="small text-secondary mt-1">The bot's latest recorded build (bot-duels) and its saved config.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Map</label>
                <select class="form-select form-select-sm" @bind="_map">
                    @foreach (var m in _maps) { <option value="@m">@m @MapName(m)</option> }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Minutes</label>
                <input type="number" min="1" max="120" class="form-control form-control-sm" @bind="_minutes" />
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Seed</label>
                <input type="number" class="form-control form-control-sm" @bind="_seed" />
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="ovr" @bind="_overrideScript" />
                    <label class="form-check-label small" for="ovr">Override skill script</label>
                </div>
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-primary" disabled="@(Runner.Current.Running || _bot == null || _map == null)" @onclick="Run">
                    @(Runner.Current.Running ? "Running…" : "Run simulation")
                </button>
            </div>
        </div>
        @if (_cfg != null)
        {
            <div class="small text-secondary mt-2">
                Saved config <code>@_cfgKey</code>: home map @_cfg.HomeMap, rest @(_cfg.RestWhenNoPotions ? $"below {_cfg.RestBelowPercent:P0}" : "off (potions)"),
                WinMargin @_cfg.WinMargin, MaxRoundsToKill @_cfg.MaxRoundsToKill@(_cfg.NoAutoAttack ? ", NoAutoAttack" : ""),
                script: <code>@(string.IsNullOrWhiteSpace(_cfg.SkillScript) ? "(none: auto-attacks only)" : _cfg.SkillScript.Replace("\n", " | "))</code>
            </div>
        }
        else if (_bot != null)
        {
            <div class="small text-warning mt-2">No saved config for @_bot: the run uses the in-code defaults (the report says so).</div>
        }
        @if (_overrideScript)
        {
            <textarea class="form-control form-control-sm mt-2 font-monospace" rows="3" placeholder="one rule per line, e.g. use Bash 0 if self.sp >= 15" @bind="_script"></textarea>
        }
        var st = Runner.Current;
        @if (!st.Running && st.Error != null)
        {
            <div class="alert alert-danger mt-2 mb-0 small">
                <div class="fw-semibold">Run failed: @st.Error</div>
                @if (st.Output.Length > 0) { <pre class="sim-pre mt-2 mb-0">@Tail(st.Output)</pre> }
            </div>
        }
        @if (_scansSaved.Count > 0)
        {
            <div class="fw-semibold mt-3">Bots' leveling predictions <span class="badge bg-secondary">@_scansSaved.Count</span></div>
            <div class="small text-secondary">Once per level a live bot asks: "where should I level now?" Each candidate map is hunted offline for @RouteSimulator.ScanMinutes min. Maps where it died are ruled out (the route to the one it picks is checked before it moves); the rest are ranked by exp/h, which the bot then corrects with what it really earned on maps it has hunted. ▶ plays the hunt (only the last @RouteChecks.KeepReplays scans keep replays).</div>
            <div style="max-height:24rem;overflow:auto">
                <table class="table table-sm small mt-1 mb-0" style="font-variant-numeric:tabular-nums">
                    <thead><tr><th>When</th><th>Bot</th><th class="text-end">Lv</th><th>From</th><th>Best by sim</th><th>Candidates (exp/h, best first)</th></tr></thead>
                    <tbody>
                        @foreach (var sc in _scansSaved)
                        {
                            var ranked = sc.Maps.OrderByDescending(m => m.ExpPerHour).ToList();
                            var best = ranked.FirstOrDefault(m => !m.Died);
                            <tr>
                                <td class="text-nowrap">@sc.AtUtc.ToLocalTime().ToString("MM-dd HH:mm")</td><td class="text-nowrap">@sc.Character</td><td class="text-end">@sc.Level</td><td>@sc.From</td>
                                <td class="text-nowrap fw-semibold text-success">@(best == null ? "none safe" : $"{best.Map} {best.ExpPerHour:N0}/h")</td>
                                <td>@foreach (var m in ranked)
                                {
                                    var why = m.Died ? $"died at {m.Minutes:F1} min to {m.Killer}" : $"{m.Kills} kills in {m.Minutes:F0} min";
                                    var scanReplay = m.Replay != null && Runner.PathOf(m.Replay) != null ? m.Replay : null;
                                    <span class="badge me-1 mb-1 @(m.Died ? "text-bg-danger" : "text-bg-secondary")" title="@why" role="@(scanReplay != null ? "button" : null)" @onclick="() => { if (scanReplay != null) Load(scanReplay); }">@m.Map @m.ExpPerHour.ToString("N0")@(m.Died ? " ☠" : "")@(scanReplay != null ? " ▶" : "")</span>
                                }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        }
        else if (_activeTab == "schedule")
        {
            <ScanSchedule />
        }
        else
        {
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="fw-semibold">Route survival</div>
            <span class="small text-secondary">Would @(_bot ?? "the bot") survive walking there? Each map on the live route is crossed by the live travel behavior (hazards, flee, Fly Wings, potions, defending), HP and bag carried over, over several seeds (<code>routesim</code>).</span>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">From</label>
                <select class="form-select form-select-sm" @bind="_routeFrom">
                    @foreach (var m in _allMaps) { <option value="@m">@m @MapName(m)</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">To</label>
                <select class="form-select form-select-sm" @bind="_routeTo">
                    @foreach (var m in _allMaps) { <option value="@m">@m @MapName(m)</option> }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Seeds</label>
                <input type="number" min="1" max="50" class="form-control form-control-sm" @bind="_routeSeeds" />
            </div>
            <div class="col-md-5 text-end">
                <button class="btn btn-outline-primary" disabled="@(_bot == null || _routeFrom == null || _routeTo == null)" @onclick="CheckRoute">Check route</button>
            </div>
        </div>
        @if (_route is { } rr)
        {
            <div class="mt-2 fw-semibold @(rr.FailsAt == null ? "text-success" : "text-danger")">@rr.Verdict</div>
            <div class="small text-secondary">@rr.Character Lv @rr.Level · @rr.Seeds seeds · @rr.WallSeconds.ToString("0.0")s to simulate</div>
            <table class="table table-sm small mt-2 mb-0" style="font-variant-numeric:tabular-nums">
                <thead><tr><th>#</th><th>Map</th><th>Leaves by</th><th class="text-end">Entered</th><th class="text-end">Crossed</th><th class="text-end">Died</th><th class="text-end" title="not across in @(RouteSimulator.HopSeconds / 60) min: fleeing back and forth">Blocked</th><th class="text-end">Mean s</th><th class="text-end">HP left</th><th class="text-end">Fly Wings</th><th>Killers</th><th>Replays</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < rr.Hops.Count; i++)
                    {
                        var hop = rr.Hops[i];
                        var idx = i;
                        <tr class="@(hop.Map == rr.FailsAt ? "table-danger" : "")">
                            <td>@(i + 1)</td><td>@hop.Map @MapName(hop.Map)</td><td>@hop.Leaves</td>
                            <td class="text-end">@hop.Entered</td><td class="text-end">@hop.Arrived</td><td class="text-end">@hop.Died</td><td class="text-end">@hop.Stuck</td>
                            <td class="text-end">@hop.MeanSeconds.ToString("0")</td><td class="text-end">@(hop.Arrived > 0 ? hop.MeanHpLeftPct.ToString("0") + "%" : "—")</td>
                            <td class="text-end">@hop.MeanFlyWings.ToString("0.0")</td><td>@string.Join(", ", hop.Killers)</td>
                            <td>@foreach (var run in rr.Runs.Where(r => r.Count > idx && r[idx].Replay != null)) { var o = run[idx]; var replayName = o.Replay ?? ""; var fullRoute = replayName.EndsWith(RouteSimulator.ContinuousSuffix, StringComparison.Ordinal); <a class="me-1" title="@(fullRoute ? "Play the full route" : "Play this map crossing")" href="simulation?run=@replayName" @onclick="() => SelectRouteReplay(replayName)" @onclick:preventDefault>@(fullRoute ? "⇢" : o.Died ? "☠" : o.Arrived ? "✓" : "⧗")</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_verdicts.Count > 0)
        {
            <div class="fw-semibold mt-3">Saved verdicts <span class="badge bg-secondary">@_verdicts.Count</span></div>
            <div class="small text-secondary">Every route check ever run, kept forever: the bots' "would I survive this route at this level?" answers. Click a row for its per-map table; ▶ means it still has a replay.</div>
            <div style="max-height:22rem;overflow:auto">
                <table class="table table-sm table-hover small mt-1 mb-0" style="font-variant-numeric:tabular-nums">
                    <thead><tr><th>When</th><th>Bot</th><th class="text-end">Lv</th><th>Route</th><th>Verdict</th><th class="text-end">Survived</th><th>Asked by</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var (name, r) in _verdicts)
                        {
                            <tr role="button" class="@(_playbackSelection == "route:" + name ? "table-active" : "")" @onclick="() => LoadRoute(name)">
                                <td class="text-nowrap">@Stamp(name)</td><td>@r.Character</td><td class="text-end">@r.Level</td>
                                <td class="text-nowrap">@r.From → @r.To</td>
                                <td class="@(r.FailsAt == null ? "text-success" : "text-danger")">@(r.FailsAt == null ? "✔ survives" : $"✘ dies/blocked on {r.FailsAt}")</td>
                                <td class="text-end">@r.Survived/@r.Seeds</td>
                                <td>@(RouteChecks.IsLive(name) ? "live bot" : "this page")</td>
                                <td>@(HasReplay(r) ? "▶" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Routes.LiveVerdicts.Count > 0)
        {
            <details class="mt-2"><summary class="small">Live bots' route verdicts (@Routes.LiveVerdicts.Count, kept @RouteChecks.VerdictTtl.TotalHours h per level)</summary>
                <ul class="small mb-0">@foreach (var v in Routes.LiveVerdicts) { <li><span class="@(v.Safe ? "text-success" : "text-danger")">@v.From → @v.To</span> Lv @v.Level, @v.AtUtc.ToLocalTime().ToString("HH:mm"): @v.Text</li> }</ul>
            </details>
        }
        }

        @if (PlaybackOptions() > 0)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <label class="small text-secondary text-nowrap" for="simulation-playback">Simulation to play</label>
                <select id="simulation-playback" class="form-select form-select-sm" style="max-width:36rem" value="@_playbackSelection" @onchange="e => SelectPlayback((string?)e.Value)">
                    @if (_runs.Count > 0)
                    {
                        <optgroup label="Leveling simulations">
                            @foreach (var r in _runs) { <option value="run:@r">@r</option> }
                        </optgroup>
                    }
                    @if (_routeResults.Count > 0)
                    {
                        <optgroup label="Survival simulations">
                            @foreach (var r in _routeResults) { <option value="route:@r">@r</option> }
                        </optgroup>
                    }
                    @if (_route != null && RouteReplayNames().Count > 0)
                    {
                        <optgroup label="Crossing replays for selected route">
                            @foreach (var r in RouteReplayNames()) { <option value="segment:@r">@r</option> }
                        </optgroup>
                    }
                </select>
                @if (_runs.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-danger text-nowrap" title="Delete every saved leveling run" disabled="@Runner.Current.Running" @onclick="DeleteAll">🗑 Delete all</button>
                }
                @if (_routeReplayUnavailable) { <span class="small text-secondary">This route result has no saved replay (only the last @RouteChecks.KeepReplays survival checks keep theirs).</span> }
            </div>
        }
    </div>
</div>

@if (_loadError != null)
{
    <div class="alert alert-danger small">@_loadError</div>
}
@if (_replay is { } rp)
{
    var s = rp.Summary;
    var h = rp.Duration / 3600;
    <div class="small text-secondary mb-2">
        <span class="fw-semibold text-body">@rp.Map</span> · @(rp.Duration / 60) min virtual · seed @rp.Seed · @rp.Build
        <br />Build: @rp.BuildSource · Config: @rp.Config · trace fingerprint <code>@rp.Fingerprint</code>
    </div>
    @if (rp.Failures.Count > 0)
    {
        <div class="alert alert-danger small">
            <div class="fw-semibold">Result incomplete: server code failed @rp.Failures.Count time(s) during this run (a runtime error, not a missing capability). The failing skill was withheld afterwards.</div>
            <ul class="mb-0">@foreach (var f in rp.Failures.Take(10)) { <li><code>@f</code></li> }</ul>
        </div>
    }

    <div id="sim-viewer" @ref="_viewer" class="mb-3"></div>

    <div class="d-flex flex-wrap gap-2 mb-3">
        @Tile("Kills", s.Kills.ToString("N0"), $"{s.KillsPerHour:N0}/h")
        @Tile("Base EXP", s.Exp.ToString("N0"), "database values, no rate")
        @Tile("EXP/h sustained", s.ExpPerHour.ToString("N0"), "sitting included")
        @Tile("EXP/h not sitting", s.ExpPerHourNotSitting.ToString("N0"), "resting time excluded")
        @Tile("Deaths", s.Deaths.ToString(), s.Deaths > 0 ? "revived on the spot" : "")
        @Tile("Damage taken", s.DamageTaken.ToString("N0"), $"{s.FightSecondsPerKill:0.0}s per fight")
        @Tile("Server regen", $"+{s.RegenHp:N0} HP", $"+{s.RegenSp:N0} SP")
        @Tile("Rests", s.Rests.ToString(), $"{s.RestsToWin} to win, {s.SitRefusals} refused")
        @Tile("Search per kill", $"{s.SearchSecondsPerKill:0.0}s", "wander + walk-up")
    </div>

    <div class="card mb-3"><div class="card-body">
        <div class="small fw-semibold mb-1">Where the time went</div>
        @{
            var parts = new (string Name, double Sec, string Color)[] {
                ("wandering", s.WanderSeconds, "#8e7cc3"), ("walking to targets", s.ApproachSeconds, "#ffe066"), ("fighting", s.FightSeconds, "#e5484d"),
                ("resting", s.RestSeconds, "#3b9dff"), ("wedged / idle", s.IdleSeconds, "#6c757d") };
        }
        <div class="d-flex rounded overflow-hidden" style="height:14px">
            @foreach (var p in parts.Where(p => p.Sec > 0)) { <div title="@p.Name @p.Sec.ToString("0")s" style="width:@Pct(p.Sec, rp.Duration);background:@p.Color"></div> }
        </div>
        <div class="d-flex flex-wrap gap-3 small mt-1">
            @foreach (var p in parts) { <span><span style="display:inline-block;width:10px;height:10px;background:@p.Color;border-radius:2px"></span> @p.Name @p.Sec.ToString("0")s (@((100 * p.Sec / rp.Duration).ToString("0.0"))%)</span> }
        </div>
        @if (s.NoHuntableAliveSeconds > 0) { <div class="small text-secondary mt-1">@s.NoHuntableAliveSeconds.ToString("0")s of searching with no huntable monster alive anywhere on the map (waiting on respawns).</div> }
    </div></div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="card h-100"><div class="card-body p-0">
                <div class="small fw-semibold p-2">Skills (executed by the server)</div>
                @if (s.Skills.Count == 0) { <div class="small text-secondary px-2 pb-2">No skill script: auto-attacks only.</div> }
                else
                {
                    <table class="table table-sm mb-0 small" style="font-variant-numeric:tabular-nums">
                        <thead><tr><th>Skill</th><th class="text-end">Lv</th><th class="text-end" title="rule fired">Fired</th><th class="text-end" title="packets sent">Sent</th><th class="text-end" title="cast bars started">Bars</th><th class="text-end" title="queued behind the after-cast delay">Queued</th><th class="text-end">Executed</th><th class="text-end">SP</th><th class="text-end">Damage</th><th class="text-end">Kills</th><th>Refused by the server / notes</th></tr></thead>
                        <tbody>
                            @foreach (var k in s.Skills)
                            {
                                <tr>
                                    <td>@k.Skill</td><td class="text-end">@k.Level</td><td class="text-end">@k.Fired</td><td class="text-end">@k.Sent</td><td class="text-end">@k.CastBars</td><td class="text-end">@k.Queued</td><td class="text-end">@k.Executed</td>
                                    <td class="text-end">@k.SpSpent</td><td class="text-end">@k.Damage.ToString("N0")</td><td class="text-end">@k.Kills</td>
                                    <td>
                                        @foreach (var (why, n) in k.Rejected) { <span class="badge text-bg-warning me-1">@why ×@n</span> }
                                        @if (k.NoServerHandler) { <span class="badge text-bg-secondary me-1">no server handler</span> }
                                        @if (k.Sent > 0 && k.Executed == 0 && k.Rejected.Count == 0 && k.CastBars == 0 && k.Queued == 0) { <span class="badge text-bg-warning me-1" title="see the no-effect events">sent, no effect</span> }
                                        @if (k.Blocked != null) { <span class="badge text-bg-danger me-1" title="@k.Blocked">FAILED ×@k.Failures</span> }
                                        @foreach (var (st2, n) in k.Statuses) { <span class="badge text-bg-dark border me-1">@st2 ×@n</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (s.RuleSkips.Count > 0) { <div class="small text-secondary p-2">Rules skipped: @string.Join("; ", s.RuleSkips.OrderByDescending(x => x.Value).Take(6).Select(x => $"{x.Key} ×{x.Value}"))</div> }
                }
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100"><div class="card-body p-0">
                <div class="small fw-semibold p-2">Monsters</div>
                <table class="table table-sm mb-0 small" style="font-variant-numeric:tabular-nums">
                    <thead><tr><th>Monster</th><th class="text-end">Pop</th><th class="text-end">Seen</th><th class="text-end">Killed</th><th class="text-end">s/kill</th><th>Forecast (full HP)</th></tr></thead>
                    <tbody>
                        @foreach (var t in s.Types)
                        {
                            <tr title="@string.Join(", ", t.Rejected.Select(x => $"{x.Key} ×{x.Value}"))">
                                <td>@t.Name</td><td class="text-end">@t.Population</td><td class="text-end">@t.Seen</td><td class="text-end">@t.Killed</td>
                                <td class="text-end">@(t.Killed > 0 ? t.FightSecondsPerKill.ToString("0.0") : "—")</td><td>@t.Forecast</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="small text-secondary p-2">@s.PickDecisions target decisions, @s.Picks picks. Rejections: @(s.Rejections.Count == 0 ? "none" : string.Join(", ", s.Rejections.Select(x => $"{x.Key} ×{x.Value}")))</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-3"><div class="card-body">
        <div class="small fw-semibold mb-2">What this simulation models (from the simulator's own capability list for this run)</div>
        <div class="row g-2">
            @foreach (var (level, title, blurb) in Levels)
            {
                var caps = rp.Capabilities.Where(c => c.Level == level).ToList();
                if (caps.Count == 0) continue;
                <div class="col-lg-6">
                    <div class="small fw-semibold">@title <span class="text-secondary fw-normal">— @blurb</span></div>
                    @foreach (var c in caps)
                    {
                        <div class="cap-@level ps-2 my-1 small"><span class="fw-semibold">@c.Area.</span> @c.What <span class="text-secondary">@c.Implication</span></div>
                    }
                </div>
            }
        </div>
    </div></div>

    <details class="mb-4"><summary class="small">Full text report (the CLI's, same run)</summary><pre class="sim-pre mt-2">@rp.Report</pre></details>
}

@code {
    protected override int RefreshMs => 1000;
    private static readonly string ScriptVersion = DateTime.UtcNow.Ticks.ToString(); // a new sim.js per app start, as WorldMap does
    private List<string> _bots = new(), _maps = new(), _runs = new();
    private string? _bot, _map, _selected, _loadError, _cfgKey;
    private double _minutes = 10;
    private int _seed = 7;
    private bool _overrideScript;
    private string _script = "";
    private BotBehaviorConfig? _cfg;
    private HuntReplay? _replay;
    private ElementReference _viewer;
    private IJSObjectReference? _module;
    private bool _mount;
    private string? _lastFinished;
    private List<string> _allMaps = new(), _routeResults = new();
    private string? _routeFrom, _routeTo;
    private int _routeSeeds = 5;
    private RouteResult? _route;
    private int _routeSeen;
    private bool _routeReplayUnavailable;
    private string _activeTab = "leveling";
    private string? _playbackSelection;

    private static readonly (string, string, string)[] Levels =
    {
        ("server", "Game server code", "runs the server's own implementation"),
        ("shared", "Live bot code", "the same decision code the live bot runs"),
        ("approximated", "Approximated", "simplified; read the effect on the numbers"),
        ("absent", "Not modelled", "missing from this world; the result can't show it"),
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _bots = Runner.BotsWithBuilds();
        _maps = Bots.Data.MonstersById.Values.SelectMany(m => m.Spawns ?? new()).Select(s => s.Map)
            .Where(m => Bots.Data.MapsByCode.ContainsKey(m)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(m => m).ToList();
        _runs = Runner.Runs();
        if (_bots.Count > 0) PickBot(_bots[0]);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var run = q.TryGetValue("run", out var v) ? v.ToString() : _runs.FirstOrDefault();
        if (run != null) Load(run);
        Runner.Changed += OnRunnerChanged;
        _allMaps = Bots.Data.MapsByCode.Keys.Where(m => Bots.Data.GetWalkMap(m) != null).OrderBy(m => m).ToList();
        _routeFrom = _allMaps.FirstOrDefault(m => m == "prontera") ?? _allMaps.FirstOrDefault();
        _routeTo = _cfg?.HomeMap is { } home && _allMaps.Contains(home) ? home : _allMaps.FirstOrDefault();
        _routeSeen = Routes.Results().Count;
        _scansSaved = Routes.SavedScans();
        _scanSeen = Routes.LiveScans.Count;
        _routeResults = ReplayableRoutes();
        if (run == null && LatestPageRoute() is { } page) LoadRoute(page); // a saved leveling run wins; live bots' checks have no replay
        Routes.Changed += OnRoutesChanged;
    }

    private void CheckRoute()
    {
        if (_bot == null || _routeFrom == null || _routeTo == null) return;
        Routes.Request(_bot, _routeFrom, -1, -1, _routeTo, _routeSeeds);
    }

    private void LoadRoute(string name)
    {
        var route = Routes.Load(name);
        _route = route;
        _activeTab = "survival";
        _playbackSelection = "route:" + name;
        _routeReplayUnavailable = false;
        string? replay = null;
        if (route != null)
            foreach (var outcome in route.Runs.SelectMany(run => run))
                if (outcome.Replay is { } candidate && Runner.PathOf(candidate) != null && (replay == null || candidate.EndsWith(RouteSimulator.ContinuousSuffix, StringComparison.Ordinal)))
                    replay = candidate;
        if (replay != null) Load(replay, "survival", "route:" + name);
        else
        {
            _replay = null;
            _selected = null;
            _mount = false;
            _loadError = null;
            _routeReplayUnavailable = route != null;
        }
    }

    private void OnRoutesChanged() => _ = InvokeAsync(() =>
    {
        var results = Routes.Results();
        if (results.Count != _routeSeen)
        {
            _routeResults = ReplayableRoutes();
            if (results.Count > 0 && !RouteChecks.IsLive(results[0])) LoadRoute(results[0]); // a page check just finished
        }
        _routeSeen = results.Count;
        if (Routes.LiveScans.Count != _scanSeen) { _scanSeen = Routes.LiveScans.Count; _scansSaved = Routes.SavedScans(); }
        _runs = Runner.Runs();
        StateHasChanged();
    });

    private void PickBot(string bot)
    {
        _bot = bot;
        _cfgKey = Configs.List().FirstOrDefault(k => k.EndsWith(" " + bot, StringComparison.OrdinalIgnoreCase));
        _cfg = _cfgKey != null ? Configs.Get(_cfgKey) : null;
        if (_cfg != null && _maps.Contains(_cfg.HomeMap, StringComparer.OrdinalIgnoreCase)) _map = _cfg.HomeMap;
        _map ??= _maps.FirstOrDefault();
        _script = _cfg?.SkillScript ?? "";
    }

    private void Run()
    {
        if (_bot == null || _map == null) return;
        Runner.Start(new SimRunner.Request(_map, _bot, Math.Clamp(_minutes, 0.5, 120), _seed, _overrideScript ? _script : null));
    }

    private void OnRunnerChanged() => _ = InvokeAsync(() =>
    {
        _runs = Runner.Runs();
        var st = Runner.Current;
        if (!st.Running && st.ReplayName != null && st.ReplayName != _lastFinished)
        {
            _lastFinished = st.ReplayName;
            Load(st.ReplayName);
        }
        StateHasChanged();
    });

    private void SelectPlayback(string? selection)
    {
        if (string.IsNullOrEmpty(selection)) return;
        _playbackSelection = selection;
        if (selection.StartsWith("route:", StringComparison.Ordinal)) LoadRoute(selection[6..]);
        else if (selection.StartsWith("segment:", StringComparison.Ordinal)) SelectRouteReplay(selection[8..]);
        else if (selection.StartsWith("run:", StringComparison.Ordinal)) Load(selection[4..]);
    }

    private void SelectRouteReplay(string name) => Load(name, "survival", "segment:" + name);

    private List<string> RouteReplayNames() => _route is not { } route ? new() : route.Runs.SelectMany(r => r)
        .Select(o => o.Replay).Where(n => n != null).Cast<string>().Distinct(StringComparer.Ordinal).ToList();

    // Results whose replay is still on disk (verdicts are kept forever, replays only for the last RouteChecks.KeepReplays checks).
    // ponytail: reads every saved result on each new one; index replays by result name if route-checks/ grows to thousands.
    private List<string> ReplayableRoutes()
    {
        _verdicts = Routes.Results().Select(n => (n, r: Routes.Load(n))).Where(x => x.r != null).Select(x => (x.n, x.r!)).ToList();
        return _verdicts.Where(v => HasReplay(v.Result)).Select(v => v.Name).ToList();
    }

    private bool HasReplay(RouteResult r) => r.Runs.SelectMany(run => run).Any(o => o.Replay != null && Runner.PathOf(o.Replay) != null);
    private List<(string Name, RouteResult Result)> _verdicts = new();
    private List<LevelScan> _scansSaved = new();
    private int _scanSeen;
    private static string Stamp(string name) => DateTime.TryParseExact(name.Split('_')[0], "yyyyMMdd-HHmmss", null, System.Globalization.DateTimeStyles.None, out var t) ? t.ToString("MM-dd HH:mm") : "";

    private string? LatestPageRoute() => _routeResults.FirstOrDefault(r => !RouteChecks.IsLive(r));

    private int PlaybackOptions() => _runs.Count + _routeResults.Count + RouteReplayNames().Count;

    private async Task DeleteAll()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete all {_runs.Count} saved runs? This can't be undone.")) return;
        Runner.DeleteAll();
        _runs = Runner.Runs();
        _replay = null; _selected = null; _loadError = null;
        _playbackSelection = null;
        if (LatestPageRoute() is { } page) LoadRoute(page);
        else _activeTab = "leveling";
    }

    /// <summary>Plays a saved replay, showing <paramref name="tab"/> with <paramref name="selection"/> picked (default: a leveling run).</summary>
    private void Load(string name, string tab = "leveling", string? selection = null)
    {
        _routeReplayUnavailable = false;
        _activeTab = tab;
        _playbackSelection = selection ?? "run:" + name;
        try
        {
            _replay = Runner.Load(name);
            _selected = name;
            _loadError = _replay == null ? $"No saved run '{name}'." : null;
            _mount = _replay != null;
        }
        catch (Exception e) { _replay = null; _loadError = $"Couldn't read {name}: {e.Message}"; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mount || _replay == null) return;
        _mount = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", $"./js/sim.js?v={ScriptVersion}");
        await _module.InvokeVoidAsync("mount", _viewer, "sim-replay/" + Uri.EscapeDataString(_selected!), PlayerLook(_replay),
            Bots.Data.SkillInfoById.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.Name)); // shout names, as WorldMap.Shout
    }

    // The bot's sprites (SimSprites): the look recorded with the build, else the character's if it's logged in now.
    private object? PlayerLook(HuntReplay rp)
    {
        var who = rp.BuildSource is { } src && src.IndexOf("'s build", StringComparison.Ordinal) is > 0 and var i ? src[..i] : null;
        var live = who == null ? null : Bots.GetSnapshots().FirstOrDefault(s => s.CharacterName == who);
        var look = live == null ? null : Bots.GetSession(live.Id)?.WithState(w => new RoBotClient.Simulation.Appearance(w.Self.IsMale, w.Self.HeadType, w.Self.HairColor));
        return Sprites.Player(rp, look);
    }

    private RenderFragment Tile(string label, string value, string sub) => @<div class="sim-tile"><div class="l">@label</div><div class="v">@value</div><div class="l">@sub</div></div>;
    private static string Pct(double part, double whole) => (100 * part / Math.Max(1e-9, whole)).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private string MapName(string code) => Bots.Data.MapsByCode.TryGetValue(code, out var m) && !string.IsNullOrEmpty(m.Name) ? $"({m.Name})" : "";
    private static string Tail(string s) => s.Length > 4000 ? "…" + s[^4000..] : s;

    public async ValueTask DisposeAsync()
    {
        Runner.Changed -= OnRunnerChanged;
        Routes.Changed -= OnRoutesChanged;
        base.Dispose();
        if (_module != null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
